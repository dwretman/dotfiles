# Credentials for the private Ferroamp GitLab PyPI sources, as 1Password
# references (no secrets here). Loaded by `op run` in the poetry wrapper in
# ~/.zshrc. Poetry reads POETRY_HTTP_BASIC_<SOURCE NAME>_USERNAME/_PASSWORD,
# with the source name uppercased and "-" replaced by "_".
POETRY_HTTP_BASIC_FERROAMP_ECLOUD_GATEWAY_PROTOCOL_PYPI_USERNAME=__token__
POETRY_HTTP_BASIC_FERROAMP_ECLOUD_GATEWAY_PROTOCOL_PYPI_PASSWORD="op://Ferroamp/GitLab PyPi/credential"
POETRY_HTTP_BASIC_FERROAMP_FERRO_SCHEMAS_PYPI_USERNAME=__token__
POETRY_HTTP_BASIC_FERROAMP_FERRO_SCHEMAS_PYPI_PASSWORD="op://Ferroamp/GitLab PyPi/credential"
POETRY_HTTP_BASIC_FERROAMP_EHUBAPPS_PYPI_USERNAME=__token__
POETRY_HTTP_BASIC_FERROAMP_EHUBAPPS_PYPI_PASSWORD="op://Ferroamp/GitLab PyPi/credential"
