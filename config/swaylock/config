# swaylock look: Ceratopsian wallpaper, One Dark indicator colors
# (see ~/.config/sway/SETUP.md). Colors are rrggbb[aa]. Docs: man swaylock
image=/usr/share/desktop-base/ceratopsian-theme/wallpaper/contents/images/1920x1200.svg
scaling=fill
color=282c34

font=JetBrainsMono Nerd Font
indicator-radius=80
indicator-caps-lock
show-failed-attempts
ignore-empty-password

# Idle: dark ring
inside-color=282c34cc
ring-color=5c6370
line-uses-inside
separator-color=00000000
text-color=abb2bf
# Typing / backspace
key-hl-color=61afef
bs-hl-color=d19a66
# Checking password
inside-ver-color=282c34cc
ring-ver-color=61afef
text-ver-color=61afef
# Wrong password
inside-wrong-color=282c34cc
ring-wrong-color=e06c75
text-wrong-color=e06c75
# Caps Lock on
ring-caps-lock-color=d19a66
caps-lock-key-hl-color=e5c07b
text-caps-lock-color=d19a66
inside-caps-lock-color=282c34cc
